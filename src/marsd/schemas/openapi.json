            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 256,
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "Login"
      },
      "Register": {
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 8192,
            "title": "Path"
          },
          "strong": {
            "type": "boolean",
            "title": "Strong",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path"
        ],
        "title": "Register"
      },
      "Request": {
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "inspect",
              "nodes",
              "preview",
              "profile",
              "diff",
              "validate"
            ],
            "title": "Operation"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "version_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Version Id"
          },
          "other": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Other"
          },
          "node": {
            "type": "string",
            "title": "Node",
            "default": "/"
          },
          "selection": {
            "type": "string",
            "title": "Selection",
            "default": ""
          },
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Columns"
          },
          "offset": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Offset",
            "default": 0
          },
          "limit": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 64
          },
          "max_rows": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Max Rows",
            "default": 100000
          },
          "timeout": {
            "type": "number",
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Timeout",
            "default": 30
          },
          "keys": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Keys"
          },
          "position": {
            "type": "boolean",
            "title": "Position",
