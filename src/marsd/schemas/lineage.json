{
  "$defs": {
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s/\\\\\\x00-\\x1f]+$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s/\\\\\\x00-\\x1f]+$",
          "title": "Target",
          "type": "string"
        },
        "relation": {
          "enum": [
            "used",
            "generated",
            "validated",
            "applies",
            "checked_against",
            "references",
            "derived"
          ],
          "title": "Relation",
          "type": "string"
        },
        "evidence": {
          "default": "declared",
          "enum": [
            "declared",
            "inferred"
          ],
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "relation"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s/\\\\\\x00-\\x1f]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "artifact_version",
            "run",
            "contract",
            "validation",
            "entity",
            "reference_set"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "title": "Node",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "importer_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Importer Id",
      "type": "string"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 1000,
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "maxItems": 3000,
      "title": "Edges",
      "type": "array"
    }
  },
  "required": [
    "importer_id",
    "event_id"
  ],
  "title": "Declaration",
  "type": "object"
}
